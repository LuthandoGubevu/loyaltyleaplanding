
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Platform staff (super-admin) — restricted to two named accounts.
    // Checked directly against the verified auth token email, independent of
    // any Firestore document, so staff access can never be broken by a bad
    // write to a user's profile.
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email.lower() in ['timlasive@gmail.com', 'lgubevu@gmail.com'];
    }

    // Helper function to check if a user is a business admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function myBusinessId() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.businessId;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // A user can create their own profile document, but the role they
      // claim is constrained: 'staff' only for the allowed staff emails,
      // 'admin' only alongside a businessId, 'customer' always allowed.
      allow create: if request.auth.uid == userId && (
        (request.resource.data.role == 'staff' && isStaff()) ||
        (request.resource.data.role == 'admin' && request.resource.data.businessId is string) ||
        (request.resource.data.role == 'customer')
      );

      // A user can read their own profile. Staff or a business admin can read any user's profile.
      allow read: if request.auth.uid == userId || isStaff() || isAdmin();

      // A user can update their own profile data, but cannot change their role.
      allow update: if request.auth.uid == userId && request.resource.data.role == resource.data.role;

      // Staff can update any user's profile, including changing their role.
      allow update: if isStaff();

      // Only staff can delete a user document.
      allow delete: if isStaff();
    }

    // Rules for the 'demo-requests' collection. These are leads for Loyalty
    // Leap itself (submitted via the public "Book a Demo" form) — not data
    // belonging to any one client business, so only staff may read them.
    match /demo-requests/{requestId} {
      // Anyone can create (submit) a demo request.
      allow create: if true;

      // Only platform staff can read, update, or delete demo requests.
      allow read, update, delete: if isStaff();
    }

    // Rules for the 'businesses' collection — one document per client business.
    match /businesses/{businessId} {
      // Staff can read any business. A business admin can read their own
      // business. A brand-new signed-up user can read a business whose
      // pending assignment matches their own verified email, so the signup
      // flow can find (only) their own pending assignment.
      allow read: if isStaff()
        || (request.auth != null && myBusinessId() == businessId)
        || (request.auth != null && request.auth.token.email.lower() == resource.data.assignedAdminEmail);

      // Only staff can onboard or remove a business.
      allow create, delete: if isStaff();

      allow update: if isStaff()
        // The one-time "claim" transition at signup: a brand-new user may
        // only flip adminUid from null to themself, only if their verified
        // email matches this business's assigned admin email, only when
        // nothing else on the document changes.
        || (
          request.auth != null
          && resource.data.adminUid == null
          && request.resource.data.adminUid == request.auth.uid
          && request.auth.token.email.lower() == resource.data.assignedAdminEmail
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUid', 'status'])
          && request.resource.data.status == 'active'
        )
        // The owning admin may update their own business's basic profile
        // fields, but not their plan, assignment, or claim state.
        || (
          isAdmin() && resource.data.adminUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminUid', 'assignedAdminEmail', 'plan', 'status'])
        );
    }

    // Rules for 'businesses/{businessId}/members/{uid}' — a customer's points
    // balance at one business. A customer's own client is the only thing
    // that ever writes here (no server exists), so the rules themselves are
    // the entire enforcement: the points delta and the cooldown window are
    // both verified against the business's own configured values, not
    // trusted from the client.
    match /businesses/{businessId}/members/{uid} {
      // Staff, the owning business admin, or the member themself can read it.
      allow read: if isStaff()
        || (request.auth != null && request.auth.uid == uid)
        || (isAdmin() && myBusinessId() == businessId);

      // First-ever scan at this business: the doc may only be created with
      // exactly one scan's worth of points.
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.points ==
             get(/databases/$(database)/documents/businesses/$(businessId)).data.pointsPerScan
        && request.resource.data.lastScanAt == request.time;

      // Every later scan: points may only increase by exactly one scan's
      // worth, only once the business's cooldown has elapsed since the
      // member's last recorded scan, and nothing else on the doc may change.
      allow update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.points ==
             resource.data.points +
             get(/databases/$(database)/documents/businesses/$(businessId)).data.pointsPerScan
        && request.resource.data.lastScanAt == request.time
        && request.time > resource.data.lastScanAt +
             duration.value(get(/databases/$(database)/documents/businesses/$(businessId)).data.scanCooldownHours, 'h')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points', 'lastScanAt']);

      // Nobody deletes a points balance from the client.
      allow delete: if false;
    }

    // Rules for 'businesses/{businessId}/scans/{scanId}' — an append-only
    // audit log of every successful scan, one doc per scan.
    match /businesses/{businessId}/scans/{scanId} {
      allow read: if isStaff() || (isAdmin() && myBusinessId() == businessId);

      allow create: if request.auth != null
        && request.resource.data.customerUid == request.auth.uid
        && request.resource.data.pointsAwarded ==
             get(/databases/$(database)/documents/businesses/$(businessId)).data.pointsPerScan
        && request.resource.data.scannedAt == request.time;

      // Append-only: no editing or deleting a past scan record.
      allow update, delete: if false;
    }

    // Future-proofing for other collections (e.g., stores, rewards)
    // You can add more specific rules here as your app grows.
    
    match /stores/{storeId} {
      // Anyone authenticated can view stores
      allow read: if request.auth != null;
      // Only admins can create, update, or delete stores
      allow write: if isAdmin();
    }
    
    match /rewards/{rewardId} {
       // Anyone authenticated can view rewards
      allow read: if request.auth != null;
      // Only admins can create, update, or delete rewards
      allow write: if isAdmin();
    }
  }
}
