
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Platform staff (super-admin) — restricted to two named accounts.
    // Checked directly against the verified auth token email, independent of
    // any Firestore document, so staff access can never be broken by a bad
    // write to a user's profile.
    function isStaff() {
      return request.auth != null &&
        request.auth.token.email.lower() in ['timlasive@gmail.com', 'lgubevu@gmail.com'];
    }

    // The business's own adminUid is the source of truth for who runs it.
    // A user's profile role/businessId alone is never trusted for access.
    function isBusinessAdmin(businessId) {
      return request.auth != null &&
        get(/databases/$(database)/documents/businesses/$(businessId)).data.adminUid == request.auth.uid;
    }

    // At signup, an account may only link itself to a business that staff
    // assigned to its email and that nobody has claimed yet.
    function canClaimBusiness(businessId) {
      let business = get(/databases/$(database)/documents/businesses/$(businessId)).data;
      return request.auth.token.email.lower() == business.assignedAdminEmail
        && (business.adminUid == null || business.adminUid == request.auth.uid);
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // A user can create their own profile document, but the role they
      // claim is constrained: 'staff' only for the allowed staff emails,
      // 'admin' only for a business staff assigned to this account's email
      // and not yet claimed by anyone else, 'customer' always allowed (and
      // never with a businessId).
      allow create: if request.auth.uid == userId && (
        (request.resource.data.role == 'staff' && isStaff()) ||
        (request.resource.data.role == 'admin'
          && request.resource.data.businessId is string
          && canClaimBusiness(request.resource.data.businessId)) ||
        (request.resource.data.role == 'customer' && !('businessId' in request.resource.data))
      );

      // A user can read their own profile. Staff can read any user's profile.
      allow read: if request.auth.uid == userId || isStaff();

      // A user can update their own profile data, but cannot change their
      // role or which business they belong to.
      allow update: if request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'businessId']);

      // Staff can update any user's profile, including changing their role.
      allow update: if isStaff();

      // Only staff can delete a user document.
      allow delete: if isStaff();
    }

    // Rules for the 'demo-requests' collection. These are leads for Loyalty
    // Leap itself (submitted via the public "Book a Demo" form) — not data
    // belonging to any one client business, so only staff may read them.
    match /demo-requests/{requestId} {
      // Anyone can create (submit) a demo request.
      allow create: if true;

      // Only platform staff can read, update, or delete demo requests.
      allow read, update, delete: if isStaff();
    }

    // Rules for the 'businesses' collection — one document per client business.
    match /businesses/{businessId} {
      // Staff can read any business. A business admin can read their own
      // business. A brand-new signed-up user can read a business whose
      // pending assignment matches their own verified email, so the signup
      // flow can find (only) their own pending assignment.
      allow read: if isStaff()
        || (request.auth != null && resource.data.adminUid == request.auth.uid)
        || (request.auth != null && request.auth.token.email.lower() == resource.data.assignedAdminEmail);

      // Only staff can onboard or remove a business.
      allow create, delete: if isStaff();

      allow update: if isStaff()
        // The one-time "claim" transition at signup: a brand-new user may
        // only flip adminUid from null to themself, only if their verified
        // email matches this business's assigned admin email, only when
        // nothing else on the document changes.
        || (
          request.auth != null
          && resource.data.adminUid == null
          && request.resource.data.adminUid == request.auth.uid
          && request.auth.token.email.lower() == resource.data.assignedAdminEmail
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['adminUid', 'status'])
          && request.resource.data.status == 'active'
        )
        // The owning admin may update their own business's basic profile
        // fields, but not their plan, assignment, claim state, or loyalty
        // programme (saved through the server so plan limits apply).
        || (
          request.auth != null && resource.data.adminUid == request.auth.uid
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['adminUid', 'assignedAdminEmail', 'plan', 'status', 'program'])
        );

      // Loyalty data. Rewards, members, stamp log entries and till codes are
      // written only by the server (Admin SDK, which bypasses these rules), so the
      // browser can never add stamps itself.
      function ownsBusiness() {
        return isBusinessAdmin(businessId);
      }

      // Rewards are defined by the business admin through the server (which
      // enforces the plan's reward limit); any signed-in user may see them so
      // customers know what they're working towards.
      match /rewards/{rewardId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /members/{memberId} {
        allow read: if isStaff() || ownsBusiness()
          || (request.auth != null && resource.data.uid == request.auth.uid);
        allow write: if false;
      }

      match /stampLog/{entryId} {
        allow read: if isStaff() || ownsBusiness();
        allow write: if false;
      }

      match /tillCodes/{code} {
        allow read: if ownsBusiness();
        allow write: if false;
      }
    }

    // Future-proofing for other collections (e.g., stores, rewards)
    // You can add more specific rules here as your app grows.
    
    match /stores/{storeId} {
      // Anyone authenticated can view stores
      allow read: if request.auth != null;
      // Legacy collection: only platform staff may write
      allow write: if isStaff();
    }
    
    match /rewards/{rewardId} {
       // Anyone authenticated can view rewards
      allow read: if request.auth != null;
      // Legacy collection (rewards now live under each business): only
      // platform staff may write
      allow write: if isStaff();
    }
  }
}
