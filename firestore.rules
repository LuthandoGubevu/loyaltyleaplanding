rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // A list of admin email addresses.
    function isAdmin() {
      return request.auth.token.email in ['lgubevu@gmail.com', 'timesesethu6@gmail.com'];
    }

    // Rules for demo-requests collection
    // - Allow anyone to create (submit the form)
    // - Only allow admins to read the requests
    // - Only admins can modify or delete requests
    match /demo-requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true; // Anyone can submit a demo request
      allow update, delete: if isAdmin();
    }

    // Rules for users collection (placeholder for future use)
    // - A user can only read/write their own data
    // - Admins can read any user's data
    match /users/{userId} {
      allow read, update, delete: if request.auth.uid == userId || isAdmin();
      allow create: if request.auth.uid == userId;
    }
    
    // Rules for stores collection (placeholder for future use)
    // - Allow any authenticated user to read/list stores
    // - Only allow admins to create, update, or delete stores
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
  }
}
