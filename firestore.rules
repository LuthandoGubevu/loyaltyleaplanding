
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user is an admin.
    // This can be expanded later to check for a role in the user's document.
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'lgubevu@gmail.com';
    }

    // Demo Requests:
    // - Anyone can create (submit the form).
    // - Only the admin can read the list of requests.
    // - No one can update or delete them from the client-side.
    match /demo-requests/{requestId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if false;
    }

    // User Data:
    // This collection is not yet used but is anticipated.
    // - A user can read and write to their own document.
    // - The admin can read any user's document.
    match /users/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }
    
    // Stores Data:
    // This collection is not yet used but is anticipated.
    // - Any authenticated user can read the store list.
    // - Only admins will be able to add/edit stores in the future.
    match /stores/{storeId} {
       allow read: if request.auth != null;
       allow write: if isAdmin();
    }
  }
}
